"""Log central de atividades. Buffer em memória (para a UI ler) + arquivo.

Use log(msg) de qualquer módulo. A UI lê via get_logs().
"""

from __future__ import annotations

import threading
from collections import deque
from datetime import datetime
from pathlib import Path

from paths import data_path

_LOCK = threading.Lock()
_BUF: deque[str] = deque(maxlen=500)
_FILE = data_path("activity.log")


def log(message: str) -> None:
    line = f"{datetime.now().strftime('%H:%M:%S')}  {message}"
    with _LOCK:
        _BUF.append(line)
    print(line)
    try:
        _FILE.parent.mkdir(parents=True, exist_ok=True)
        with _FILE.open("a", encoding="utf-8") as f:
            f.write(line + "\n")
    except Exception:
        pass


def get_logs(limit: int = 200) -> list[str]:
    with _LOCK:
        items = list(_BUF)
    return items[-limit:]


def log_file():
    return _FILE
